{
  "name": "@aryan-binazir/pi-interactive-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Independent interactive tools and agent workflows for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "docs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/questionnaire/index.ts",
      "./extensions/memory/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/effort/index.ts",
      "./extensions/btw/index.ts",
      "./extensions/vi-mode/index.ts",
      "./extensions/prompt-stash/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/worktree/index.ts",
      "./extensions/mcp-client/index.ts",
      "./extensions/web-search/index.ts",
      "./extensions/computer-use/index.ts",
      "./extensions/fast-mode/index.ts",
      "./extensions/auto-caffeinate/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test extensions/*/*.test.ts tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "1.3.7"
  },
  "dependencies": {
    "typescript": "~5.9.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.5.0",
    "zod": "^4.6.2",
    "@earendil-works/pi-ai": "0.85.1"
  }
}
