{
  "name": "@aryan-binazir/pi-interactive-tools",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "Independent interactive tools and agent workflows for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "docs",
    "APPEND_SYSTEM.md",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/questionnaire/index.ts",
      "./extensions/todo/index.ts",
      "./extensions/effort/index.ts",
      "./extensions/btw/index.ts",
      "./extensions/vi-mode/index.ts",
      "./extensions/prompt-stash/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/worktree/index.ts",
      "./extensions/computer-use/index.ts",
      "./extensions/fast-mode/index.ts",
      "./extensions/auto-caffeinate/index.ts",
      "./extensions/auto-permissions-status/index.ts",
      "./extensions/nvim-ide/index.ts",
      "./extensions/guard/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test extensions/*/*.test.ts tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typescript": "~5.9.3"
  }
}
