# Destructive Railway operations are always blocked. Guardian loads this file on every machine and applies
# it even when Guardian is disabled or the sandbox is off. A forbidden rule outranks every allow rule,
# approval and setting. Never test these rules by running Railway commands.
#
# Rules match the command's basename, so `railway`, `/opt/homebrew/bin/railway` and `~/.railway/bin/railway`
# are all covered. Literal commands nested in control flow, substitutions, `sudo`, `env` and inner shells are
# extracted and matched the same way.

prefix_rule(
    pattern = [["railway", "railwayapp"], ["delete", "down", "destroy", "teardown"]],
    decision = "forbidden",
    justification = "destructive Railway operations are permanently blocked; report the blocker to the user or use a read-only alternative",
    match = ["railway delete", "railway down --yes", "railway destroy"],
    not_match = ["railway status", "railway logs"],
)

prefix_rule(
    pattern = [["railway", "railwayapp"], ["volume", "volumes", "database", "db", "storage"], ["delete", "rm", "remove", "detach", "destroy", "reset", "wipe", "restore"]],
    decision = "forbidden",
    justification = "destructive Railway operations are permanently blocked; report the blocker to the user or use a read-only alternative",
    match = ["railway volume delete", "railway volume detach", "railway db reset"],
    not_match = ["railway volume list"],
)

prefix_rule(
    pattern = [["railway", "railwayapp"], ["environment", "env", "service", "project", "plugin", "add-on"], ["delete", "rm", "remove", "destroy"]],
    decision = "forbidden",
    justification = "destructive Railway operations are permanently blocked; report the blocker to the user or use a read-only alternative",
    match = ["railway environment delete staging", "railway service delete"],
    not_match = ["railway environment", "railway service"],
)

# Anything that can reach a Railway database or run commands with its credentials is reviewed, so the
# reviewer can apply the Railway policy to the actual statement, client or script.
prefix_rule(
    pattern = [["railway", "railwayapp"], ["connect", "run", "shell", "ssh", "redeploy", "link", "unlink", "variables", "volume", "volumes", "database", "db", "storage", "environment", "env", "service", "project"]],
    decision = "prompt",
    justification = "Railway commands that can reach databases are reviewed before they run",
    match = ["railway connect postgres", "railway run psql", "railway volume list"],
    not_match = ["railway status", "railway whoami"],
)
